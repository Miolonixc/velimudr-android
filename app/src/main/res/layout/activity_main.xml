<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:colorBackground">

    <!-- Two round controls: big VPN hub + small style toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnHub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@android:drawable/ic_lock_idle_lock"
                app:backgroundTint="@color/brand_purple"
                app:tint="@color/white"
                app:fabCustomSize="96dp"
                app:maxImageSize="48dp"
                android:contentDescription="Подключить VPN" />

            <!-- green connected dot -->
            <View
                android:id="@+id/dotConnected"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_dot"
                android:visibility="gone" />

            <!-- progress while connecting -->
            <ProgressBar
                android:id="@+id/progressHub"
                style="?android:attr/progressBarStyle"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- small style toggle -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@android:drawable/ic_menu_sort_by_size"
            app:backgroundTint="@color/brand_purple_light"
            app:tint="@color/white"
            app:fabCustomSize="56dp"
            app:maxImageSize="28dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Стиль общения" />
    </LinearLayout>

    <!-- status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Нажми круг, чтобы подключиться"
        android:textSize="13sp"
        android:textColor="?android:textColorSecondary" />

    <!-- chat -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tvChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:textSize="14sp"
                android:textIsSelectable="true" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- input + mic/photo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Сообщение..."
            android:inputType="text"
            android:background="@null" />
        <ProgressBar
            android:id="@+id/progressBusy"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Голос" />
        <ImageButton
            android:id="@+id/btnPhoto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Фото" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➤"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>
</LinearLayout>
